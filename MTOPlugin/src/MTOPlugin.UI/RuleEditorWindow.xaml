<Window x:Class="MTOPlugin.UI.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule Editor - Bộ Quy Tắc" Height="680" Width="900"
        Background="#FFFFFF" Foreground="#1A1A1A"
        WindowStartupLocation="CenterScreen">
    <!-- MAU NEN/CHU dat TUONG MINH - tranh nen den lam mat chu
         (cung loi da gap o MainPanel) -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F4F7FA"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#CBD5E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#CBD5E0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DCE6F1"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="btnAdd" Content="+ Thêm Rule" Click="BtnAdd_Click"/>
            <Button x:Name="btnImport" Content="Nhập từ JSON" Click="BtnImport_Click"/>
            <Button x:Name="btnExport" Content="Xuất JSON" Click="BtnExport_Click"/>
            <Button x:Name="btnValidate" Content="Kiểm tra" Click="BtnValidate_Click"/>
            <Button x:Name="btnSave" Content="Lưu" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button x:Name="btnCancel" Content="Hủy" Click="BtnCancel_Click"/>
        </StackPanel>

        <!-- FILTER -->
        <GroupBox Grid.Row="1" Header="Lọc" Margin="0,4">
            <StackPanel Orientation="Horizontal" Margin="4">
                <TextBlock Text="Tìm:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="txtSearch" Width="160" VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_Changed"/>
                <TextBlock Text="Hệ:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox x:Name="cmbFilterSystem" Width="120" SelectionChanged="CmbFilter_Changed"/>
                <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox x:Name="cmbFilterStatus" Width="90" SelectionChanged="CmbFilter_Changed">
                    <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="Draft"/>
                    <ComboBoxItem Content="Paused"/>
                </ComboBox>
            </StackPanel>
        </GroupBox>

        <!-- RULE LIST -->
        <DataGrid Grid.Row="2" x:Name="dgRules" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgRules_SelectionChanged"
                  RowHeaderWidth="0" HeadersVisibility="Column" GridLinesVisibility="All" FontSize="11">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="90"/>
                <DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}" Width="55"/>
                <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="180"/>
                <DataGridTextColumn Header="Hệ" Binding="{Binding SystemCode}" Width="80"/>
                <DataGridTextColumn Header="Mã vật tư" Binding="{Binding MaterialCode}" Width="90"/>
                <DataGridTextColumn Header="Tên vật tư" Binding="{Binding MaterialName}" Width="150"/>
                <DataGridTextColumn Header="ĐV" Binding="{Binding Unit}" Width="40"/>
                <DataGridTextColumn Header="Cách tính" Binding="{Binding Calculation}" Width="100"/>
                <DataGridTextColumn Header="Ưu tiên" Binding="{Binding Priority}" Width="50"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- EDIT FORM -->
        <GroupBox Grid.Row="3" Header="Sửa rule" Margin="0,4">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã quy tắc:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCode" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Phiên bản:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtVersion" Text="1.0" VerticalContentAlignment="Center"/>

                    <!-- Row 1 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Hệ thống:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbSystem"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Trạng thái:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbStatus">
                        <ComboBoxItem Content="Active" IsSelected="True"/>
                        <ComboBoxItem Content="Draft"/>
                        <ComboBoxItem Content="Paused"/>
                    </ComboBox>

                    <!-- Row 2 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mã vật tư:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtMaterialCode" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Tên vật tư:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtMaterialName" VerticalContentAlignment="Center"/>

                    <!-- Row 3 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Quy cách:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtSpecification" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Đơn vị:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox Grid.Row="3" Grid.Column="3" x:Name="cmbUnit">
                        <ComboBoxItem Content="cái" IsSelected="True"/>
                        <ComboBoxItem Content="m"/>
                        <ComboBoxItem Content="bộ"/>
                        <ComboBoxItem Content="sợi"/>
                    </ComboBox>

                    <!-- Row 4: Conditions -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Loại đối tượng:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cmbEntityKind">
                        <ComboBoxItem Content="block" IsSelected="True"/>
                        <ComboBoxItem Content="geometry"/>
                        <ComboBoxItem Content="*"/>
                    </ComboBox>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Layers:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="3" x:Name="txtLayers" VerticalContentAlignment="Center"
                             ToolTip="Phân cách bằng ';', wildcard *"/>

                    <!-- Row 5 -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Block names:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtBlockNames" VerticalContentAlignment="Center"
                             ToolTip="Phân cách bằng ';', wildcard *"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Attributes:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="5" Grid.Column="3" x:Name="txtAttributes" VerticalContentAlignment="Center"
                             ToolTip="KEY=VALUE; dùng ~ để phủ định"/>

                    <!-- Row 6: Calculation -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Cách tính:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cmbCalculation">
                        <ComboBoxItem Content="Count" IsSelected="True"/>
                        <ComboBoxItem Content="SumLength"/>
                        <ComboBoxItem Content="SumLengthTimesFactor"/>
                        <ComboBoxItem Content="SumLengthCeilingStep"/>
                        <ComboBoxItem Content="SumAttributeValue"/>
                        <ComboBoxItem Content="CountIfAttributeEquals"/>
                    </ComboBox>
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Hệ số / Bước:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <StackPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal">
                        <TextBox x:Name="txtFactor" Text="1.0" Width="60" VerticalContentAlignment="Center"
                                 ToolTip="Factor cho SumLengthTimesFactor"/>
                        <TextBox x:Name="txtCeilingStep" Text="0" Width="60" VerticalContentAlignment="Center"
                                 Margin="4,0,0,0" ToolTip="Bước làm tròn cho SumLengthCeilingStep"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <!-- VALIDATION RESULT -->
        <TextBox Grid.Row="4" x:Name="txtValidation" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" FontSize="11" Foreground="#333"
                 Text="Kết quả kiểm tra sẽ hiển thị ở đây."/>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="5">
            <TextBlock x:Name="txtStatus" Text="Sẵn sàng"/>
        </StatusBar>
    </Grid>
</Window>
