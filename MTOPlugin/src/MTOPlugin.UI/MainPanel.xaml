<UserControl x:Class="MTOPlugin.UI.MainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720" d:DesignWidth="380"
             mc:Ignorable="d"
             Background="#FFFFFF" Foreground="#1A1A1A"
             Name="PanelRoot">
    <!-- ============================================================
         MAU NEN / MAU CHU
         Loi da gap: panel KHONG dat Background -> nen trong suot/den,
         va hau het Label/TextBlock/RadioButton khong dat Foreground
         -> chu DEN tren nen DEN = khong doc duoc.
         Nay dat tuong minh: nen TRANG, chu DEN DAM cho MOI control.
         ============================================================ -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="MtoFg" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="MtoFgMuted" Color="#5A6672"/>
        <SolidColorBrush x:Key="MtoAccent" Color="#1F4E79"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="#2D6CA0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F4F7FA"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#CBD5E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#CBD5E0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DCE6F1"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">

            <TextBlock Text="BÓC TÁCH KHỐI LƯỢNG M&amp;E"
                       FontSize="16" FontWeight="Bold" Foreground="#1F4E79"/>
            <TextBlock Text="Bước 1: quét &amp; phân loại. Bước 2: chọn mục rồi xuất Excel."
                       FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>

            <!-- PHẠM VI -->
            <Label Content="1. Phạm vi quét"/>

            <RadioButton x:Name="rbSelection" Content="Vùng chọn (Selection)" GroupName="Scope"/>
            <RadioButton x:Name="rbModel" Content="Toàn bộ Model" GroupName="Scope"/>
            <RadioButton x:Name="rbCurrentLayout" Content="Model + Layout hiện tại" GroupName="Scope"/>
            <RadioButton x:Name="rbAllLayouts" Content="Toàn bộ Layout (Paper)" GroupName="Scope"/>
            <RadioButton x:Name="rbModelAllLayouts" Content="Model + Tất cả Layout"
                         IsChecked="True" GroupName="Scope"/>

            <Label Content="2. Chế độ Xref"/>

            <ComboBox x:Name="cmbXrefMode">
                <ComboBoxItem Content="Bỏ qua Xref"/>
                <ComboBoxItem Content="Tính 1 lần theo file nguồn" IsSelected="True"/>
                <ComboBoxItem Content="Tính theo từng lần chèn"/>
            </ComboBox>

            <Label Content="3. Bộ quy tắc (JSON)"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtRulesPath" Grid.Column="0"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="btnBrowseRules" Grid.Column="1"
                        Content="..." Click="BtnBrowseRules_Click"/>
            </Grid>

            <Label Content="4. Đơn vị xuất"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Nguồn:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbSourceUnit" Width="90" Margin="4,0">
                    <ComboBoxItem Content="mm"/>
                    <ComboBoxItem Content="cm"/>
                    <ComboBoxItem Content="m"/>
                    <ComboBoxItem Content="ft"/>
                    <ComboBoxItem Content="in"/>
                </ComboBox>
                <TextBlock Text="→ Xuất:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbOutputUnit" Width="90" Margin="4,0">
                    <ComboBoxItem Content="mm"/>
                    <ComboBoxItem Content="cm"/>
                    <ComboBoxItem Content="m"/>
                    <ComboBoxItem Content="ft"/>
                    <ComboBoxItem Content="in"/>
                </ComboBox>
            </StackPanel>

            <Label Content="5. File xuất (XLSX)"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtOutputPath" Grid.Column="0"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="btnBrowseOutput" Grid.Column="1"
                        Content="..." Click="BtnBrowseOutput_Click"/>
            </Grid>

            <Label Content="6. Chỉnh sửa quy tắc"/>
            <Button x:Name="btnRuleEditor" Content="Mở Rule Editor" Click="BtnRuleEditor_Click"/>

            <Label Content="7. Thực hiện (2 bước)"/>

            <Button x:Name="btnScan" Content="Bước 1: Quét + Phân loại (nạp danh sách)"
                    FontWeight="Bold" Click="BtnScan_Click"/>

            <TextBlock Text="Chọn các mục cần xuất:" FontSize="10" Foreground="Gray" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnSelAll" Content="Chọn tất cả" Click="BtnSelectAll_Click"/>
                <Button x:Name="btnSelNone" Content="Bỏ chọn" Click="BtnSelectNone_Click"/>
            </StackPanel>

            <Button x:Name="btnExportSel" Content="Bước 2: Xuất Excel các mục đã chọn"
                    FontWeight="Bold" Click="BtnExportSelected_Click"/>
            <Button x:Name="btnExportAll" Content="Xuất Excel TOÀN BỘ" Click="BtnExportAll_Click"/>

            <!-- KẾT QUẢ (FR07) -->
            <GroupBox Header="Kết quả quét" Margin="0,10,0,0">
                <StackPanel Margin="4">
                    <TextBlock Text="Nhấp đúp một dòng để phóng tới đối tượng trong bản vẽ."
                               FontSize="9" Foreground="Gray" TextWrapping="Wrap"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="280">
                        <DataGrid x:Name="dgResult" AutoGenerateColumns="False" IsReadOnly="False"
                                  RowHeaderWidth="0" HeadersVisibility="Column" GridLinesVisibility="All"
                                  SelectionMode="Single" MouseDoubleClick="DgResult_MouseDoubleClick"
                                  FontSize="11">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Chọn"
                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="40"/>
                                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="36" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Hệ" Binding="{Binding SystemCode}" Width="55" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Mã" Binding="{Binding MaterialCode}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tên vật tư / công việc" Binding="{Binding MaterialName}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Quy cách" Binding="{Binding Specification}" Width="95" IsReadOnly="True"/>
                                <DataGridTextColumn Header="ĐV" Binding="{Binding Unit}" Width="36" IsReadOnly="True"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding QuantityText}" Width="65" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="95" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Layout" Binding="{Binding Layout}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Handle" Binding="{Binding Handle}" Width="70" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Đã quét:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtScanned" Text="0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="1" Text="Đã phân loại:"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtClassified" Text="0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="2" Text="Chưa phân loại:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtUnclassified" Text="0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="3" Text="Lỗi / Cảnh báo:"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtWarnings" Text="0" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <Border Background="#F4F7FA" BorderBrush="#B0BEC5" BorderThickness="1"
                    Margin="0,8,0,0" Padding="6,4">
                <TextBlock x:Name="txtLog" Foreground="#1A1A1A"
                           FontFamily="Consolas" FontSize="10"
                           TextWrapping="Wrap" Height="120"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>